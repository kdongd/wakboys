# Render 환경변수에 그대로 넣는 값들 (이 파일은 참고용, 실제 값은 커밋하지 말 것)
APP_BASE_URL=https://wakboys.onrender.com

# Neon (JDBC 형식)
DATABASE_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/wakboys?sslmode=require
DATABASE_USERNAME=wakboys_owner
DATABASE_PASSWORD=

# 32자 이상 아무 랜덤 문자열 (render.yaml 쓰면 자동 생성)
JWT_SECRET=

# Kakao Developers > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_JS_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wakboys
R2_PUBLIC_BASE_URL=

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
